# Copy to .env for local Docker / VPS runs. On Render these are set in
# render.yaml (and overridable in the dashboard), so you do NOT need this file
# there.
PORT=10000
HOST=0.0.0.0
DATA_SOURCE=tradingview
MIN_CONF=0.70
HISTORY_HOURS=72
RETRAIN_EVERY=60
WEB_PAIRS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCHF,USDCAD
WEB_INTERVALS=1m,5m,15m

# Cross-pair confirmation: a second model trained on every live pair must agree
# before a signal counts as tradeable. Measured on 15m it lifted the hit rate
# from 55.2% to 57.8% and helped every pair, at the cost of fewer signals.
# Needs several pairs live at once; leave 0 for a single-pair setup.
CONSENSUS=0

# Paper-trading ledger: append-only WIN/LOSS record of resolved signals.
# On Render, point LEDGER_PATH at a mounted disk so it survives redeploys.
LEDGER_ENABLED=1
LEDGER_PATH=var/ledger.jsonl

# Optional: Quotex source only. Needs a residential IP (Cloudflare blocks
# datacenter logins). Leave DATA_SOURCE=tradingview to skip this entirely.
# QUOTEX_EMAIL=
# QUOTEX_PASSWORD=
# QUOTEX_SESSION_FILE=
# QUOTEX_PROXY=

# Optional: local session capture server (scripts/session_capture.py). Binds to
# loopback only. Set CAPTURE_KEY to require a shared key from the userscript.
CAPTURE_HOST=127.0.0.1
CAPTURE_PORT=8787
# CAPTURE_KEY=
